# rpchub configuration
# CHAIN_IDS is the only required setting (optional if you run Solana-only).

# HTTP port
PORT=9563

# Enabled EVM chains: comma separated chainlist chain ids.
CHAIN_IDS=1,56

# Solana exception path (/solana). Chainlist is EVM-only, so Solana uses a
# built-in public endpoint list. SOLANA_RPCS entries are added IN FRONT of it
# and imply SOLANA_ENABLED=true. Mainnet-beta only (genesis hash is verified).
SOLANA_ENABLED=false
#SOLANA_RPCS=https://my-solana-node.example

# Your own private nodes, highest priority (http:// is allowed here).
#EXTRA_RPCS_1=https://my-eth-node.local:8545
#EXTRA_RPCS_56=http://10.0.0.5:8545
#EXTRA_RPCS_SOLANA=https://my-sol-node.local

# Extra path tokens: /bsc -> chain 56. Format: alias:chainId[,alias:chainId]
#ALIASES=bsc:56

# How often to refetch chainlist / probe endpoints.
REFRESH_INTERVAL=1h
PROBE_INTERVAL=30s

# Per-upstream-attempt timeout and max endpoints tried per request.
REQUEST_TIMEOUT=15s
MAX_RETRIES=3

# Endpoints more than this many blocks behind the pool median are benched.
# (Solana: x20 slots.)
MAX_BLOCK_LAG=10

# true: keep only chainlist entries marked tracking=none (privacy).
FILTER_TRACKING=false

# true: also accept the plaintext http:// and ws:// schemes from chainlist
# (your own EXTRA_RPCS nodes are trusted regardless).
ALLOW_HTTP=false

# WebSocket support: ws://<host>/{chain} and ws://<host>/{chain}/ws relay to
# the chain's wss endpoints, so eth_subscribe / logsSubscribe work. Endpoints
# are health-probed like the HTTP ones. MAX_WS_CONNS caps concurrent relayed
# connections (each one holds an upstream connection open).
WS_ENABLED=true
MAX_WS_CONNS=256

# Where the chainlist snapshot is cached for offline boots.
CACHE_DIR=./data

# Override the chainlist source if needed.
#CHAINLIST_URL=https://chainlist.org/rpcs.json

# debug | info | warn | error
LOG_LEVEL=info
